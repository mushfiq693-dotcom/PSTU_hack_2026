# FastPay Backend Environment Variables
PORT=5001
NODE_ENV=development

# JWT Secret for Auth
JWT_SECRET=fastpay_production_jwt_secret_pstu_2026

# Database Connection (Local or Hosted PostgreSQL like Supabase/Neon/Render)
DATABASE_URL=postgresql://postgres:your_password@ep-xyz-123.ap-southeast-1.aws.neon.tech/fastpay?sslmode=require

# (Optional fallback individual parameters if DATABASE_URL is not used)
PGHOST=localhost
PGPORT=5432
PGDATABASE=fastpay
PGUSER=postgres
PGPASSWORD=your_local_password
